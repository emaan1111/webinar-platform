  @@unique([webinarjamWebinarId, webinarjamUserId])
  @@index([webinarjamWebinarId])
  @@index([email])
  @@index([registeredAt])
  @@index([facebookSent])
  @@map("webinarjam_processed_registrations")
}

// External Webinar Integration (WebinarJam/EverWebinar)
// Allows using external platforms while keeping all CRM functionality in this app
model ExternalWebinar {
  id                  String  @id @default(cuid())
  name                String // Internal name for this connection
  platform            String  @default("webinarjam") // "webinarjam" or "everwebinar"
  externalWebinarId   String // The ID from WebinarJam/EverWebinar
  externalWebinarName String? // Name from the external platform
  apiKey              String? // Optional: webinar-specific API key
  isActive            Boolean @default(true)

  // Sync settings
  syncAttendance Boolean   @default(true)
  lastSyncAt     DateTime?

  // Tag settings (same as internal webinars)
  registrationTag         String?
  registrationTagId       Int?
  attendedTag             String?
  attendedTagId           Int?
  mostlyAttendedTag       String?
  mostlyAttendedTagId     Int?
  partlyAttendedTag       String?
  partlyAttendedTagId     Int?
  missedTag               String?
  missedTagId             Int?
  replayAttendedTag       String?
  replayAttendedTagId     Int?
  mostlyAttendedThreshold Int?    @default(70) // % watched to be "mostly attended"
  attendanceTagDelayHours Int     @default(24) // Hours to wait after registration before tagging
  webinarDurationMinutes  Int     @default(60) // Expected webinar length for % calculations

  // SMS settings
  autoSendPostSessionSMS          Boolean @default(false)
  postSessionSMSMinutesAfter      Int     @default(0)
  postSessionSMSMinWatchedMinutes Int?
  postSessionSMSBody              String?

  // JIT (Just-In-Time) settings
  isJIT    Boolean  @default(false)
  jitTimes String[] @default(["11:00", "14:00", "18:00"]) // Times in HH:MM format (user's local)

  // Combined seamless picker (live Zoom + just-in-time + recurring EverWebinar times).
  // Defaults ON so new external webinars use the seamless picker out of the box.
  combineScheduleSources Boolean  @default(true)
  // One real LIVE Zoom session mixed into the picker, indistinguishable from evergreen options.
  liveZoomEnabled        Boolean  @default(false)
  liveZoomLink           String? // Zoom join URL the registrant is sent to for the live session
  liveZoomAt             DateTime? // Start time of the live Zoom session (stored UTC)
  liveZoomTimezone       String? // Timezone the host entered liveZoomAt in (for reference/labels)
  // When true, registrants are offered ONLY the linked Zoom sessions' times — the
  // just-in-time option and recurring EverWebinar times are hidden from the picker.
  zoomOnlySchedule       Boolean   @default(false)
  // When set, the live Zoom session is driven by a shared ZoomSession (its link/time/timezone are
  // snapshotted into the fields above). Selecting one also links this webinar into that session's roster.
  liveZoomSessionId      String?
  // A single "starting soon" just-in-time option (registers into EverWebinar's JIT block).
  showJustInTime         Boolean  @default(true)
  jitLeadMinutes         Int      @default(15) // Minutes from now the JIT option starts
  // How many upcoming recurring EverWebinar sessions (e.g. daily 11 AM) to show. null = all upcoming.
  recurringSlotsToShow   Int?     @default(2)
  // Where to send registrants after a scheduled/Zoom pick (read live by the embed, so changing
  // it doesn't require re-pasting the snippet). Blank = stay in the popup. JIT picks always go
  // to the countdown page regardless.
  thankYouUrl            String?
  // Optional system Thank-You template rendered by the built-in /thank-you-external/<id> page.
  // Plain scalar FK (resolved via a separate findUnique), mirroring Webinar.thankYouTemplateId.
  thankYouTemplateId     String?
  // Optional system Countdown template rendered by the built-in /countdown-external/<id> page
  // (shown to just-in-time picks while they wait, then auto-enters the live room). Plain scalar FK.
  countdownTemplateId    String?

  // Facebook CAPI
  sendToFacebookCAPI Boolean @default(true)

  // CRM Integration
  crmIntegration CrmIntegration @default(CLICKFUNNELS)

  // Emaan email-management integration. Blank = off. When set, registrations are
  // POSTed to this emaan lead-webhook URL (the contact's list/tag/workflow are
  // configured on the emaan endpoint behind the token). emaanSyncScope decides
  // which sessions push: "ALL" = every session (EverWebinar + live Zoom),
  // "ZOOM_ONLY" = only the live Zoom session.
  emaanWebhookUrl String?
  emaanSyncScope  String  @default("ALL") // "ALL" | "ZOOM_ONLY"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  leadPages     LeadPage[]
  registrations ExternalWebinarRegistration[]
  schedules     ExternalWebinarSchedule[]
  zoomSessionLinks ZoomSessionWebinar[]
  liveZoomSession  ZoomSession? @relation("ExternalWebinarLiveZoom", fields: [liveZoomSessionId], references: [id], onDelete: SetNull)

  confirmationEmails ConfirmationEmailTemplate[]
  reminderEmails     ReminderEmailTemplate[]
  followUpEmails     FollowUpEmailTemplate[]

  @@unique([platform, externalWebinarId])
  @@index([isActive])
  @@map("external_webinars")
}

// Schedules for external webinars
model ExternalWebinarSchedule {
  id                 String   @id @default(cuid())
  externalWebinarId  String
  externalScheduleId String? // Schedule ID from WebinarJam
  scheduledAt        DateTime
  timezone           String?
  comment            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  externalWebinar ExternalWebinar               @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  registrations   ExternalWebinarRegistration[]

  @@index([externalWebinarId])
  @@index([scheduledAt])
  @@map("external_webinar_schedules")
}

// Registration records for external webinars (mirrors Registration model)
model ExternalWebinarRegistration {
  id                String  @id @default(cuid())
  externalWebinarId String
  scheduleId        String?

  // Registrant info
  name     String
  email    String
  phone    String?
  timezone String?
  country  String?

  // External platform IDs
  externalUserId         String? // User ID from WebinarJam
  externalRegistrationId String? // Registration ID from WebinarJam

  // Join links captured at registration (so the countdown page can auto-enter the room)
  liveRoomUrl   String? // EverWebinar live room (or Zoom link for a live-Zoom pick)
  replayRoomUrl String?

  // Registration tracking
  registeredAt       DateTime  @default(now())
  scheduledStartTime DateTime?
  registrationSource String    @default("lead_page") // "lead_page", "api_sync", "manual"
  leadPageId         String?

  // Attendance tracking (synced from external platform)
  attended            Boolean   @default(false)
  joinedAt            DateTime?
  leftAt              DateTime?
  watchTimeMinutes    Int       @default(0)
  watchTimePercentage Int       @default(0)

  // Tagging status
  attendanceTagsApplied   Boolean   @default(false)
  attendanceTagsAppliedAt DateTime?
  appliedTag              String? // Which attendance tag was applied

  // SMS status
  postSessionSmsSent   Boolean   @default(false)
  postSessionSmsSentAt DateTime?

  // Facebook CAPI status
  facebookCapiSent   Boolean   @default(false)
  facebookCapiSentAt DateTime?

  // Consent
  privacyConsent   Boolean @default(true)
  marketingConsent Boolean @default(false)

  // Email opt-out (footer link or RFC 8058 one-click). Mirrors Registration so
  // the scheduler's isEmailUnsubscribed() works for both registration kinds.
  emailUnsubscribed   Boolean   @default(false)
  emailUnsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  externalWebinar        ExternalWebinar          @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  schedule               ExternalWebinarSchedule? @relation(fields: [scheduleId], references: [id])
  confirmationEmailSends ConfirmationEmailSend[]
  reminderEmailSends     ReminderEmailSend[]
  followUpEmailSends     FollowUpEmailSend[]

  @@unique([externalWebinarId, email])
  @@index([externalWebinarId])
  @@index([email])
  @@index([registeredAt])
  @@index([attended])
  @@index([attendanceTagsApplied])
  @@map("external_webinar_registrations")
}

// ─── Confirmation Email Templates & Tracking ───────────────────────────────

model ConfirmationEmailTemplate {
  id                String  @id @default(cuid())
  webinarId         String? // Made optional for external webinars support
  externalWebinarId String? // Support for external webinars
  name              String  @default("Registration Confirmation")

  webinar         Webinar?         @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  externalWebinar ExternalWebinar? @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  subject         String
  htmlBody        String           @db.Text
  fromName        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sends ConfirmationEmailSend[]

  @@index([webinarId])
  @@index([externalWebinarId])
  @@map("confirmation_email_templates")
}

model ConfirmationEmailSend {
  id                     String    @id @default(cuid())
  templateId             String
  registrationId         String?
  externalRegistrationId String?
  to                     String
  subject                String
  status                 String    @default("SENT") // SENT, FAILED
  sentAt                 DateTime  @default(now())
  openedAt               DateTime?
  clickedAt              DateTime?
  openCount              Int       @default(0)
  clickCount             Int       @default(0)
  userAgent              String?
  errorMessage           String?

  template             ConfirmationEmailTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  registration         Registration?                @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  externalRegistration ExternalWebinarRegistration? @relation(fields: [externalRegistrationId], references: [id], onDelete: Cascade)
  events               EmailTrackingEvent[]

  @@index([templateId])
  @@index([registrationId])
  @@index([sentAt])
  @@map("confirmation_email_sends")
}

model EmailTrackingEvent {
  id                  String   @id @default(cuid())
  sendId              String?
  type                String // OPEN, CLICK
  url                 String? // clicked URL (for CLICK events)
  userAgent           String?  @db.Text
  ipAddress           String?
  deviceType          String? // mobile, desktop, tablet
  emailType           String   @default("confirmation") // confirmation, reminder, followup
  reminderEmailSendId String?
  followUpEmailSendId String?
  createdAt           DateTime @default(now())

  send              ConfirmationEmailSend? @relation(fields: [sendId], references: [id], onDelete: Cascade)
  reminderEmailSend ReminderEmailSend?     @relation(fields: [reminderEmailSendId], references: [id], onDelete: Cascade)
  followUpEmailSend FollowUpEmailSend?     @relation(fields: [followUpEmailSendId], references: [id], onDelete: Cascade)

  @@index([sendId])
  @@index([reminderEmailSendId])
  @@index([followUpEmailSendId])
  @@index([type])
  @@index([createdAt])
  @@map("email_tracking_events")
}

// ─── Reminder Email Templates & Tracking ───────────────────────────────────

model ReminderEmailTemplate {
  id                String  @id @default(cuid())
  webinarId         String? // Made optional for external webinars
  externalWebinarId String? // Support for external webinars
  name              String  @default("Reminder")

  webinar            Webinar?         @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  externalWebinar    ExternalWebinar? @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  subject            String
  subjectB           String? // A/B test: alternate subject line
  htmlBody           String           @db.Text
  fromName           String?
  minutesBefore      Int // e.g. 1440 (24hr), 120 (2hr), 60 (1hr), 10, 1
  isActive           Boolean          @default(true)
  skipIfJoined       Boolean          @default(true) // Smart skip: don't send if already joined webinar
  resendToNonOpeners Boolean          @default(false)
  resendAfterHours   Int? // Hours after original send to resend
  resendSubject      String? // Subject for resend (defaults to subjectB or original)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  sends ReminderEmailSend[]

  @@index([webinarId])
  @@index([minutesBefore])
  @@map("reminder_email_templates")
}

model ReminderEmailSend {
  id                     String    @id @default(cuid())
  templateId             String
  registrationId         String?
  externalRegistrationId String?
  to                     String
  subject                String
  abVariant              String    @default("A") // A or B
  isResend               Boolean   @default(false) // true if this is a non-opener resend
  status                 String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, SKIPPED, CANCELLED
  scheduledFor           DateTime?
  sentAt                 DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  openCount              Int       @default(0)
  clickCount             Int       @default(0)
  userAgent              String?
  errorMessage           String?
  retryCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  template             ReminderEmailTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  registration         Registration?                @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  externalRegistration ExternalWebinarRegistration? @relation(fields: [externalRegistrationId], references: [id], onDelete: Cascade)
  events               EmailTrackingEvent[]

  @@index([templateId])
  @@index([registrationId])
  @@index([status, scheduledFor])
  @@index([sentAt])
  @@map("reminder_email_sends")
}

// ─── Follow-Up Email Templates & Tracking ──────────────────────────────────

model FollowUpEmailTemplate {
  id                String  @id @default(cuid())
  webinarId         String? // Made optional for external webinars
  externalWebinarId String? // Support for external webinars
  name              String  @default("Follow-Up")

  webinar            Webinar?         @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  externalWebinar    ExternalWebinar? @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  subject            String
  subjectB           String? // A/B test: alternate subject line
  htmlBody           String           @db.Text
  fromName           String?
  delayMinutes       Int // delay after webinar ends, e.g. 0 (immediate), 60, 2880 (2 days)
  audienceType       String           @default("all") // all, attended, mostly_attended, partly_attended, missed, replay
  isActive           Boolean          @default(true)
  skipIfPurchased    Boolean          @default(false) // Smart skip: don't send if already purchased
  resendToNonOpeners Boolean          @default(false)
  resendAfterHours   Int?
  resendSubject      String?
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  sends FollowUpEmailSend[]

  @@index([webinarId])
  @@index([audienceType])
  @@map("followup_email_templates")
}

model FollowUpEmailSend {
  id                     String    @id @default(cuid())
  templateId             String
  registrationId         String?
  externalRegistrationId String?
  to                     String
  subject                String
  abVariant              String    @default("A") // A or B
  isResend               Boolean   @default(false)
  status                 String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, SKIPPED, CANCELLED
  scheduledFor           DateTime?
  sentAt                 DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  openCount              Int       @default(0)
  clickCount             Int       @default(0)
  userAgent              String?
  errorMessage           String?
  retryCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  template             FollowUpEmailTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  registration         Registration?                @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  externalRegistration ExternalWebinarRegistration? @relation(fields: [externalRegistrationId], references: [id], onDelete: Cascade)
  events               EmailTrackingEvent[]

  @@index([templateId])
  @@index([registrationId])
  @@index([status, scheduledFor])
  @@index([sentAt])
  @@map("followup_email_sends")
}

// ============ Popup Builder ============

model Popup {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  fields         Json // Array of field configs: [{id, type, label, placeholder, required, position, options, width}]
  layout         Json? // Layout config: sections, rows, columns, ordering
  styles         Json? // Style config: colors, fonts, sizes, spacing per section
  customHtml     String?  @db.Text // Optional: user-provided custom HTML
  useCustomHtml  Boolean  @default(false)
  // When set, the popup is a webinar registration popup: a "Webinar time picker" element
  // shows this webinar's times and submit registers into EverWebinar (JIT->countdown, etc.).
  externalWebinarId String?
  submitText     String   @default("Submit")
  successMessage String   @default("Thank you for your submission!")
  redirectUrl    String? // Custom on-submit redirect URL
  webhookUrl     String? // Outgoing webhook: POST each captured lead to this URL
  isActive       Boolean  @default(true)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads PopupLead[]

  @@index([userId])
  @@map("popups")
}

model PopupLead {
  id        String   @id @default(cuid())
  popupId   String
  data      Json // Submitted field values as key-value pairs
  ip        String?
  userAgent String?
  referrer  String?
  pageUrl   String? // The page the popup was embedded on
  createdAt DateTime @default(now())

  popup Popup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@index([popupId])
  @@index([createdAt])
  @@map("popup_leads")
}

// =============================================================
// Stripe checkout system: products, funnels, orders, payments
// =============================================================

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  priceInCents  Int
  currency      String   @default("usd")
  imageUrl      String?
  stripePriceId String?
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  funnelSteps FunnelStep[]
  orderItems  OrderItem[]

  @@map("products")
}

model Funnel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)

  successRedirectUrl String?

  brandColor   String?
  brandLogoUrl String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps  FunnelStep[]
  orders Order[]

  @@map("funnels")
}

enum FunnelStepType {
  ORDER_FORM
  UPSELL
  DOWNSELL
  CONFIRMATION
}

model FunnelStep {
  id       String         @id @default(cuid())
  funnelId String
  funnel   Funnel         @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  type     FunnelStepType
  order    Int

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  headline      String?
  subheadline   String?
  description   String?
  videoUrl      String?
  imageUrl      String?
  yesButtonText String?
  noButtonText  String?

  // step.order to jump to when user declines (for upsell -> downsell, etc.)
  // null = go to next step in sequence
  declineNextOrder Int?

  // Optional custom HTML/CSS for the step. When customHtml is set we render
  // it verbatim and hydrate via data-* hooks (see CustomHtmlStep component).
  customHtml String? @db.Text
  customCss  String? @db.Text

  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([funnelId, order])
  @@index([funnelId])
  @@map("funnel_steps")
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

model Order {
  id       String  @id @default(cuid())
  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id])

  email     String
  firstName String?
  lastName  String?
  phone     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  stripeCustomerId      String?
  stripePaymentMethodId String?

  status     OrderStatus @default(PENDING)
  totalCents Int         @default(0)
  currency   String      @default("usd")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([funnelId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  funnelStepId String?
  funnelStep   FunnelStep? @relation(fields: [funnelStepId], references: [id])

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  priceCents Int
  quantity   Int    @default(1)
  currency   String @default("usd")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  amountCents Int
  currency    String @default("usd")
  status      PaymentStatus @default(PENDING)

  // upsell | initial | downsell - to trace which step generated this payment
  source String?

  failureReason String?
  rawPayload    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([orderId])
  @@map("payments")
}

// Admin-created live Zoom session. Has its own link/time/timezone and is linked
// to one or more webinars (external and/or internal). The roster for a session
// is the registrants of the linked webinars whose chosen time matches the
// session's exact start time. Reporting/management only — does not change the
// registrant-facing flow.
model ZoomSession {
  id          String   @id @default(cuid())
  name        String
  zoomLink    String?
  scheduledAt DateTime // stored UTC
  timezone    String   @default("America/New_York") // tz the host entered the time in
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  webinars               ZoomSessionWebinar[]
  externalWebinarsLive   ExternalWebinar[]    @relation("ExternalWebinarLiveZoom")

  @@index([scheduledAt])
  @@map("zoom_sessions")
}

// Join row linking a ZoomSession to a webinar. Exactly one of externalWebinarId
// / webinarId is set (webinarType records which).
model ZoomSessionWebinar {
  id                String  @id @default(cuid())
  zoomSessionId     String
  webinarType       String // "external" | "internal"
  externalWebinarId String?
  webinarId         String?

  zoomSession     ZoomSession      @relation(fields: [zoomSessionId], references: [id], onDelete: Cascade)
  externalWebinar ExternalWebinar? @relation(fields: [externalWebinarId], references: [id], onDelete: Cascade)
  webinar         Webinar?         @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([zoomSessionId, externalWebinarId])
  @@unique([zoomSessionId, webinarId])
  @@index([zoomSessionId])
  @@map("zoom_session_webinars")
}
