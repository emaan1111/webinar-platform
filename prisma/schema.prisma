// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
  ATTENDEE
}

enum WebinarStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  image     String?
  role      Role     @default(ATTENDEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hostedWebinars Webinar[]      @relation("HostedWebinars")
  registrations  Registration[]
  posts          Post[]
  comments       Comment[]
  analytics      Analytics[]
  accounts       Account[]
  sessions       Session[]
  chatMessages   ChatMessage[]
  reactions      Reaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Webinar {
  id            String        @id @default(cuid())
  slug          String?       @unique // For public registration URLs (user can customize)
  internalName  String?       // Private internal name for organization (not shown to attendees)
  title         String
  description   String        @db.Text
  thumbnail     String?
  duration      Int // in minutes
  vimeoVideoId  String? // Vimeo video ID (e.g., "123456789")
  videoUrl      String? // Full URL to video (YouTube or other)
  videoDuration Int? // Actual video duration in seconds
  status        WebinarStatus @default(DRAFT)
  recordingUrl  String?
  hostId        String

  // Features Toggle
  hasReplay    Boolean @default(true)
  hasOffers    Boolean @default(true)
  hasChat      Boolean @default(true)
  hasReactions Boolean @default(true)
  showElapsedTime Boolean @default(true) // Display elapsed time on the live video

  // Replay Settings
  replayEnabled       Boolean   @default(true) // Master toggle for replay availability
  replayDurationDays  Int?      // How many days after user's session the replay is available
  replayExpiresAt     DateTime? // Absolute expiration date (optional override)

  // Registration Settings
  maxSchedulesToShow     Int     @default(3) // How many upcoming schedules to show on registration page
  registrationPageId     String? // Reference to RegistrationPage table (replaces registrationTemplateId)
  thankYouTemplateId     String? // Reference to ThankYouTemplate table
  countdownTemplateId    String? // Reference to CountdownTemplate table (same system as Thank You)
  countdownPageId        String? // Reference to CountdownPage table (deprecated, use countdownTemplateId)

  // A/B Testing Configuration
  enableABTesting     Boolean @default(false) // Master toggle for A/B testing
  trafficSplitPercent Int     @default(50) // Percentage to variant A (50 = 50/50 split)

  // Registration Page Testing
  testRegistrationPage Boolean @default(false)
  regPageAId           String? // Variant A registration page ID (replaces regTemplateAId)
  regPageBId           String? // Variant B registration page ID (replaces regTemplateBId)

  // Schedule Testing
  testSchedule Boolean @default(false)
  scheduleAIds String? // Comma-separated schedule IDs for variant A
  scheduleBIds String? // Comma-separated schedule IDs for variant B

  // Offer Testing
  testOffer Boolean @default(false)
  offerAId  String? // Variant A offer ID
  offerBId  String? // Variant B offer ID

  // Video Testing
  testVideo Boolean @default(false)
  videoAId  String? // Variant A video (Vimeo ID or URL)
  videoBId  String? // Variant B video (Vimeo ID or URL)

  // Social Share Messages (for Thank You & Countdown pages)
  whatsappShareMessage String? @db.Text // Custom WhatsApp share message
  facebookShareMessage String? @db.Text // Custom Facebook share message (if needed)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  host           User              @relation("HostedWebinars", fields: [hostId], references: [id])
  registrations  Registration[]
  analytics      Analytics[]
  offers         Offer[]
  bonusResources BonusResource[]
  chatMessages   ChatMessage[]
  reactions      Reaction[]
  schedules      WebinarSchedule[] // All schedules (specific, recurring, just-in-time)
  faqs           WebinarFaq[]      // FAQs shown during offer phase
  sales          WebinarSale[]
  
  // AI Assistant Relations
  programDocuments ProgramDocument[] // Knowledge base for AI
  aiChatConfig     AIChatConfig?     // AI configuration
  
  // Reminder System
  reminderTemplates WebinarReminderTemplate[] // Reminder templates for this webinar

  @@map("webinars")
}

model WebinarSchedule {
  id        String  @id @default(cuid())
  webinarId String
  webinar   Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  // Schedule Type
  scheduleType String // "specific", "justInTime", "recurring"

  // For specific schedules
  scheduledAt     DateTime?
  timezone        String?
  useUserTimezone Boolean   @default(false)

  // For just-in-time schedules (X minutes from registration)
  minutesFromReg Int? // Start X minutes after user registers

  // For recurring schedules
  recurringPattern String? // JSON: { interval: "daily"|"weekly"|"monthly", time: "14:00", daysOfWeek: [1,3,5] }

  // Zoom Integration (for specific date schedules)
  isZoomSession Boolean @default(false) // If true, this is a live Zoom session instead of simulated
  zoomLink      String? // Zoom meeting link for live sessions

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webinar_schedules")
}

model Offer {
  id             String   @id @default(cuid())
  webinarId      String
  webinar        Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  price          Float
  originalPrice  Float?
  discountLabel  String?
  countdownDuration Int? // Seconds for offer countdown badge
  bulletPoints   String[] @default([])
  ctaText        String   @default("Get This Offer")
  ctaUrl         String
  videoTimestamp Int // Seconds in video when offer appears
  hideAfter      Int? // Seconds after appearing when offer disappears
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BonusResource {
  id          String   @id @default(cuid())
  webinarId   String
  title       String
  description String?  @db.Text
  fileUrl     String // URL to the file
  fileType    String // pdf, video, doc, etc.
  fileSize    Int? // in bytes
  downloads   Int      @default(0)
  isPublic    Boolean  @default(false) // If true, available to all attendees
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("bonus_resources")
}

model ChatMessage {
  id             String        @id @default(cuid())
  webinarId      String
  webinar        Webinar       @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  userId         String?       // Optional - for authenticated users
  user           User?         @relation(fields: [userId], references: [id])
  registrationId String?       // Optional - for registered attendees without accounts
  registration   Registration? @relation(fields: [registrationId], references: [id])
  userName       String?       // Store name from registration or user
  message        String
  isScripted     Boolean       @default(false) // True for pre-written scripted messages
  isAI           Boolean       @default(false) // True for AI-generated responses
  videoTimestamp Int?          // Timestamp in seconds when message should appear (for scripted messages)
  isHidden       Boolean       @default(false)
  isApproved     Boolean       @default(false) // Admin approval for user messages
  createdAt      DateTime      @default(now())

  @@map("chat_messages")
}

model Reaction {
  id             String        @id @default(cuid())
  webinarId      String
  webinar        Webinar       @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  userId         String?       // Optional - for authenticated users
  user           User?         @relation(fields: [userId], references: [id])
  registrationId String?       // Optional - for registered attendees without accounts
  registration   Registration? @relation(fields: [registrationId], references: [id])
  userName       String?       // Store name from registration or user
  type           String        // "heart", "clap", "thumbsUp"
  isScripted     Boolean       @default(false) // True for pre-scripted reactions
  videoTimestamp Int           // Timestamp in seconds when reaction should appear
  isHidden       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([webinarId, videoTimestamp])
  @@map("reactions")
}

model Registration {
  id         String  @id @default(cuid())
  userId     String? // Make optional for public registrations
  webinarId  String
  scheduleId String? // Which schedule they registered for

  // Contact Information
  name  String
  email String
  phone String?

  // Timezone and Location
  timezone String? // User's timezone
  country  String? // For GDPR compliance

  // GDPR and Consent
  gdprConsent      Boolean @default(false) // For EU residents
  privacyConsent   Boolean @default(false) // Required for all
  marketingConsent Boolean @default(false) // Optional marketing emails

  // Registration Details
  registeredAt       DateTime  @default(now())
  scheduledStartTime DateTime? // The exact start time for this user's webinar session
  attended           Boolean   @default(false)
  joinedAt           DateTime? // Last time they joined (updates on refresh)
  firstJoinedAt      DateTime? // First time they ever joined (never changes, for grace period)
  leftAt             DateTime?

  // Replay Tracking
  watchedReplay      Boolean   @default(false) // Has watched replay
  replayWatchTime    Int       @default(0)     // Total seconds watched in replay
  lastWatchedPosition Int      @default(0)     // Last video timestamp where user stopped (in seconds)
  replayClickedCTA   Boolean   @default(false) // Clicked CTA during replay
  replayDevice       String?   // Device used for replay: "mobile" | "desktop"
  registrationDevice String?   // Device used during registration

  // A/B Testing
  testGroup String? // "A" or "B" - which test group they were in

  // Sales Tracking
  hasPurchased Boolean @default(false) // Set to true when they make a purchase

  // Referral System
  referralCode    String?  @unique // Unique code for this person to share (e.g., "ABC123")
  referredBy      String? // referralCode of the person who referred them
  referredByUser  Registration? @relation("Referrals", fields: [referredBy], references: [referralCode], onDelete: SetNull)
  referrals       Registration[] @relation("Referrals") // People this person referred

  // Relations
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  webinar      Webinar           @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  testMetrics  ABTestMetric[]
  sessions     AttendeeSession[]
  pageVisits   PageVisit[]
  chatMessages ChatMessage[]     // Chat messages sent by this registered attendee
  reactions    Reaction[]        // Reactions sent by this registered attendee
  sales        WebinarSale[]
  offerAnalytics OfferAnalytics[] // Offer analytics for this registration
  
  // Reminder System
  reminders    WebinarReminderSent[] // Reminders sent to this registration
  clickFunnelsReminderTags ClickFunnelsReminderTag[]

  @@index([email])
  @@index([webinarId])
  @@index([webinarId, attended])
  @@index([webinarId, registeredAt])
  @@index([userId])
  @@map("registrations")
}

// A/B Testing Metrics
model ABTestMetric {
  id        String @id @default(cuid())
  webinarId String
  visitorId String // UUID from cookie
  testGroup String // "A" or "B"

  // What was tested
  element      String // "registration" | "schedule" | "offer" | "video"
  variantShown String // Which variant they saw (template ID, schedule IDs, offer ID, video ID)

  // Tracking
  pageView       DateTime @default(now())
  converted      Boolean  @default(false)
  registrationId String? // Link to Registration if converted

  // Analytics
  timeOnPage Int? // Seconds spent on page
  clicks     Int     @default(0)
  country    String? // Visitor country
  referrer   String? // Traffic source
  device     String? // "mobile" | "desktop" | "tablet"

  createdAt DateTime @default(now())

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([webinarId, element, testGroup])
  @@index([visitorId])
  @@map("ab_test_metrics")
}

// Attendee Session Tracking
model AttendeeSession {
  id             String   @id @default(cuid())
  registrationId String
  webinarId      String
  scheduleId     String?

  // Session Times
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  lastSeenAt  DateTime @default(now()) // For detecting inactive users
  
  // Watch Duration
  totalWatchTime Int @default(0) // Total seconds watched
  videoPosition  Int @default(0) // Last known position in video (seconds)
  isWatching     Boolean @default(true)
  watchDuration  Int @default(0) // Actual watch duration (for backward compatibility)
  
  // Audio State Tracking
  watchedMuted      Boolean @default(true) // Started muted (most users do)
  mutedDuration     Int @default(0) // Seconds watched while muted
  unmutedDuration   Int @default(0) // Seconds watched while unmuted
  lastMuteState     Boolean? // Last known mute state
  
  // Status
  isActive Boolean @default(true) // Currently in webinar
  completed Boolean @default(false) // Watched to end
  
  // Device & Browser
  userAgent String?
  device    String? // "mobile" | "desktop" | "tablet"
  browser   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  registration   Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  engagements    EngagementEvent[]
  videoEvents    VideoWatchEvent[]
  pageVisits     PageVisit[]

  @@index([registrationId])
  @@index([webinarId, scheduleId])
  @@index([webinarId, completed])
  @@index([joinedAt])
  @@map("attendee_sessions")
}

// Video Watch Events - Track drop-off points
model VideoWatchEvent {
  id        String   @id @default(cuid())
  sessionId String
  webinarId String

  // Video Tracking
  timestamp    Int      // Position in video (seconds)
  eventType    String   // "play" | "pause" | "seek" | "ended" | "left"
  watchedFrom  Int?     // For seek events
  watchedTo    Int?     // For seek events
  
  createdAt DateTime @default(now())

  // Relations
  session AttendeeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([webinarId, timestamp])
  @@map("video_watch_events")
}

// Engagement Events - Chat, Reactions, Offers
model EngagementEvent {
  id        String   @id @default(cuid())
  sessionId String
  webinarId String

  // Event Details
  eventType String   // "chat" | "reaction" | "question" | "poll" | "offer_view" | "offer_click"
  eventData String?  @db.Text // JSON data (reaction type, chat message length, etc)
  timestamp Int      // Position in video when event occurred (seconds)
  
  createdAt DateTime @default(now())

  // Relations
  session AttendeeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([webinarId, eventType])
  @@index([webinarId, timestamp])
  @@map("engagement_events")
}

// Page Visit Tracking
model PageVisit {
  id             String   @id @default(cuid())
  sessionId      String?  // Linked after registration
  registrationId String?  // Linked after registration
  webinarId      String
  visitorId      String   // UUID from cookie (for pre-registration tracking)

  // Page Details
  pageType    String   // "registration" | "countdown" | "webinar" | "thank_you" | "replay"
  pageId      String?  // For registration/countdown pages: which specific page was shown (for A/B testing tracking)
  variantGroup String? // For A/B testing: "A" or "B" 
  enteredAt   DateTime @default(now())
  leftAt      DateTime?
  timeSpent   Int?     // Seconds spent on page
  
  // Referrer
  referrer    String?  @db.Text
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  
  // Device
  device      String?
  browser     String?
  country     String?
  
  createdAt DateTime @default(now())

  // Relations
  session      AttendeeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  registration Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([webinarId, pageType])
  @@index([webinarId, pageType, pageId])
  @@index([webinarId, enteredAt])
  @@index([visitorId])
  @@index([registrationId])
  @@map("page_visits")
}

// Offer Analytics
model OfferAnalytics {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String

  // Offer Details
  offerTitle     String
  offerUrl       String   @db.Text
  
  // Interaction
  sawOffer       Boolean  @default(false)
  sawOfferAt     DateTime?
  clickedOffer   Boolean  @default(false)
  clickedOfferAt DateTime?
  videoPosition  Int?     // Where in video they saw/clicked offer
  
  // Outcome
  converted      Boolean  @default(false)
  convertedAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([webinarId])
  @@index([registrationId])
  @@index([webinarId, sawOffer])
  @@index([webinarId, clickedOffer])
  @@index([webinarId, converted])
  @@map("offer_analytics")
}

model WebinarSale {
  id             String   @id @default(cuid())
  webinarId      String
  registrationId String?
  email          String

  // Order details
  orderId        String
  orderFormId    String?
  orderFormName  String?
  productName    String?
  status         String?
  amount         Float?
  currency       String?  @default("USD")
  contactId      String?
  purchasedAt    DateTime?
  rawPayload     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar      Webinar      @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([webinarId])
  @@index([registrationId])
  @@index([email])
  @@map("webinar_sales")
}

model Post {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Analytics {
  id        String   @id @default(cuid())
  userId    String?
  webinarId String?
  event     String // e.g., "page_view", "registration", "join", "leave", "chat_message"
  metadata  Json? // Flexible storage for event-specific data
  createdAt DateTime @default(now())

  // Relations
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@map("analytics")
}

// Registration Page Templates
model Template {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Default", "Minimal", "Urgency", "Islamic Mothers"
  description String?  @db.Text // Short description of the template
  htmlCode    String   @db.Text // Complete HTML with embedded CSS and JS
  thumbnail   String? // Screenshot or preview image URL
  popupStyle  String   @default("center") // Popup style: center, slide-up, slide-right, fade
  popupTheme  String   @default("purple") // Popup theme: purple, blue, green, red, orange, dark
  isSystem    Boolean  @default(false) // System templates cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}

// Thank You Page Templates
model ThankYouTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Default", "Minimal", "Download Focus", "Calendar Add"
  description String?  @db.Text // Short description of the template
  htmlCode    String   @db.Text // Complete HTML with embedded CSS and JS
  thumbnail   String? // Screenshot or preview image URL
  isSystem    Boolean  @default(false) // System templates cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("thank_you_templates")
}

// Countdown Page Templates (Legacy - kept for backward compatibility)
model CountdownTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Default", "Bold", "Minimal"
  description String?  @db.Text // Short description of the template
  htmlCode    String   @db.Text // Complete HTML with embedded CSS and JS
  thumbnail   String? // Screenshot or preview image URL
  isSystem    Boolean  @default(false) // System templates cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countdown_templates")
}

// Registration Pages (Dynamic System - replaces Template system for registration pages)
model RegistrationPage {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Default", "Bold", "Minimal", "Video Hero"
  description String?  @db.Text // Short description of the registration page
  
  // Page Content
  htmlCode    String   @db.Text // Complete HTML with embedded CSS and JS
  
  // Form Settings
  collectPhone    Boolean @default(false)
  collectCompany  Boolean @default(false)
  collectCustom1  Boolean @default(false)
  customField1Label String? // e.g., "Job Title", "Industry"
  collectCustom2  Boolean @default(false)
  customField2Label String? // e.g., "Company Size", "Role"
  
  // Display Settings
  showHostInfo    Boolean @default(true)
  showBenefits    Boolean @default(true)
  showTestimonials Boolean @default(false)
  showCountdown   Boolean @default(true)
  showSocialProof Boolean @default(true) // "X people registered"
  
  // Video Settings (for video-based registration pages)
  showVideo       Boolean @default(false)
  videoUrl        String? // YouTube, Vimeo, or other video URL
  videoTitle      String? // Title shown above/below video
  videoAutoplay   Boolean @default(false)
  
  // Testimonials (if showTestimonials is true)
  testimonial1Text   String? @db.Text
  testimonial1Author String?
  testimonial1Image  String?
  testimonial2Text   String? @db.Text
  testimonial2Author String?
  testimonial2Image  String?
  testimonial3Text   String? @db.Text
  testimonial3Author String?
  testimonial3Image  String?
  
  // Benefits/Features List (if showBenefits is true)
  benefit1 String?
  benefit2 String?
  benefit3 String?
  benefit4 String?
  benefit5 String?
  
  // Branding
  logoUrl          String? // Header logo
  primaryColor     String? @default("#4f46e5") // Main brand color (CTA buttons, etc.)
  secondaryColor   String? @default("#8b5cf6") // Secondary/accent color
  backgroundColor  String? @default("#ffffff") // Page background
  textColor        String? @default("#1f2937") // Main text color
  
  // Call-to-Action
  ctaButtonText    String? @default("Register Now")
  ctaButtonStyle   String? @default("solid") // "solid", "outline", "gradient"
  
  // Footer
  showFooter       Boolean @default(true)
  footerText       String? @db.Text // Custom footer text
  privacyPolicyUrl String?
  termsOfServiceUrl String?
  
  // SEO & Preview
  thumbnail        String? // Screenshot or preview image URL
  metaDescription  String? // For SEO
  
  // System
  isSystem    Boolean  @default(false) // System pages cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("registration_pages")
}

// Countdown Pages (New Dynamic System - Similar to Registration Pages)
model CountdownPage {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Islamic Mothers", "Default", "Minimal"
  description String?  @db.Text // Short description of the countdown page
  
  // Page Content
  htmlCode    String   @db.Text // Complete HTML with embedded CSS and JS
  
  // Video Settings (optional)
  showVideo       Boolean @default(false)
  videoUrl        String? // YouTube, Vimeo, or other video URL
  videoTitle      String? // Title shown above video
  videoPlaceholder String? @default("Watch this important message")
  
  // Bonus/Gift Settings (optional)
  showBonus       Boolean @default(false)
  bonusTitle      String? // e.g., "Stories of Great Mothers"
  bonusDescription String? @db.Text
  bonusImage      String? // URL to bonus image
  bonusValue      String? // e.g., "$47" or "Free"
  bonusBadge      String? // e.g., "FREE", "LIMITED"
  
  // Call-to-Action Settings
  showReminder    Boolean @default(true)
  showWhatsApp    Boolean @default(true)
  showFacebook    Boolean @default(true)
  showCustomCTA   Boolean @default(false)
  customCTAText   String?
  customCTAUrl    String?
  
  // Branding
  organizationName String? // For footer
  contactEmail     String? // For footer
  websiteUrl       String? // For footer
  logoUrl          String? // Header logo
  
  // Design
  thumbnail   String? // Screenshot or preview image URL
  primaryColor String? @default("#4a3b6b") // Main brand color
  accentColor  String? @default("#d53f8c") // Accent color
  
  // System
  isSystem    Boolean  @default(false) // System pages cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countdown_pages")
}

// FAQs for Webinars (shown during offer phase in live room)
model WebinarFaq {
  id         String   @id @default(cuid())
  webinarId  String
  webinar    Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  
  question   String   @db.Text // The FAQ question
  answer     String   @db.Text // The FAQ answer
  sortOrder  Int      @default(0) // Display order (lower = shown first)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("webinar_faqs")
}

// AI Program Knowledge Base - Documents for AI to use after CTA
model ProgramDocument {
  id          String   @id @default(cuid())
  webinarId   String
  webinar     Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  
  title       String   // e.g., "Program Overview", "Pricing", "FAQs"
  content     String   @db.Text // The actual content AI will use
  category    String   @default("general") // "overview", "pricing", "faq", "curriculum", "testimonials"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("program_documents")
}

// AI Chat Configuration per Webinar
model AIChatConfig {
  id          String   @id @default(cuid())
  webinarId   String   @unique
  webinar     Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  
  enabled     Boolean  @default(true)
  activateAfterOffer Boolean @default(true) // Only respond after CTA/offer is shown
  assistantName String  @default("AI Assistant") // Display name for the AI
  
  systemPrompt String? @db.Text // Custom instructions for AI
  temperature  Float   @default(0.7) // OpenAI temperature (0-1)
  maxTokens    Int     @default(500) // Max response length
  
  // Response behavior
  autoRespond  Boolean @default(true) // Automatically respond to questions
  requireApproval Boolean @default(false) // Require host approval before sending
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_chat_config")
}

// Image Library - Store uploaded images for use in pages
model Image {
  id           String   @id @default(cuid())
  filename     String   // Unique filename on disk
  originalName String   // Original uploaded filename
  url          String   // Public URL to access image
  size         Int      // File size in bytes
  mimeType     String   // image/jpeg, image/png, etc.
  width        Int?     // Image width in pixels
  height       Int?     // Image height in pixels
  
  // Metadata
  uploadedBy   String?  // User ID who uploaded
  tags         String?  // Comma-separated tags for organization
  description  String?  @db.Text // Optional description
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([uploadedBy])
  @@map("images")
}

// Webinar Reminder System
enum ReminderStatus {
  PENDING    // Not sent yet
  SENT       // Successfully sent
  FAILED     // Failed to send
  CANCELLED  // Cancelled (e.g., user unregistered)
  SKIPPED    // Skipped because webinar time has passed
}

enum ReminderChannel {
  EMAIL
  SMS
  BOTH
}

// Template for reminder timing (e.g., "24 hours before", "2 hours before")
model WebinarReminderTemplate {
  id          String   @id @default(cuid())
  webinarId   String
  webinar     Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  
  // Type of reminder
  type        String   @default("pre_webinar") // 'pre_webinar' or 'post_webinar'
  
  // Timing - Pre-webinar
  minutesBefore Int?    // Minutes before webinar start (e.g., 1440 for 24 hours, 120 for 2 hours)
  
  // Timing - Post-session
  minutesAfter Int?    // Minutes after session completion (e.g., 0 for immediate, 1440 for 1 day)
  
  // Watch criteria for post-session
  minWatchedMinutes Int?     // Minimum minutes watched (e.g., 30)
  minWatchedPercentage Int?  // Minimum percentage watched (e.g., 50)
  
  // Channels
  channel     ReminderChannel @default(EMAIL)
  
  // Email content
  emailSubject String?  // Optional when using SMS only
  emailBody    String?  @db.Text // Can use placeholders: {{name}}, {{webinarTitle}}, {{countdownLink}}, {{referralLink}}, {{webinarTime}}
  
  // SMS content
  smsBody      String? @db.Text
  
  // ClickFunnels Integration
  clickFunnelsTag String? // Tag to apply in ClickFunnels (e.g., "24HRREMINDER", "2HRREMINDER")
  applyClickFunnelsTag Boolean @default(false) // Whether to apply ClickFunnels tag
  
  // Status
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  sentReminders WebinarReminderSent[]
  
  @@index([webinarId])
  @@index([minutesBefore])
  @@map("webinar_reminder_templates")
}

// Individual reminder sent to a specific registration
model WebinarReminderSent {
  id             String   @id @default(cuid())
  
  // Links to template and registration (template is optional for post-webinar reminders)
  templateId     String?
  template       WebinarReminderTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  
  // Timing
  scheduledFor   DateTime?  // When this reminder should be sent (optional for immediate sends)
  sendAt         DateTime?  // Alias for scheduledFor (for post-webinar reminders)
  sentAt         DateTime? // When it was actually sent
  
  // Status
  status         ReminderStatus @default(PENDING)
  channel        ReminderChannel @default(SMS)
  
  // Type of reminder
  type           String @default("pre_webinar") // 'pre_webinar' or 'post_webinar'
  
  // Direct message content (for post-webinar reminders without templates)
  message        String?   @db.Text
  phone          String?   // Phone number for direct SMS
  
  // Error tracking
  errorMessage   String?   @db.Text
  error          String?   @db.Text // Alias for errorMessage
  retryCount     Int       @default(0)
  lastRetryAt    DateTime?
  
  // Email/SMS details
  emailSentTo    String?   // Email address it was sent to
  smsSentTo      String?   // Phone number it was sent to
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([registrationId])
  @@index([templateId])
  @@index([scheduledFor])
  @@index([status])
  @@index([status, scheduledFor]) // For efficient querying of pending reminders
  @@map("webinar_reminders_sent")
}

model ClickFunnelsReminderTag {
  id             String   @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tagName        String
  scheduledFor   DateTime
  status         ReminderStatus @default(PENDING)
  appliedAt      DateTime?
  attempts       Int      @default(0)
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([registrationId])
  @@index([status, scheduledFor])
  @@unique([registrationId, tagName])
  @@map("clickfunnels_reminder_tags")
}
