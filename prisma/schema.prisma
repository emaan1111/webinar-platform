generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  password         String
  image            String?
  role             Role              @default(ATTENDEE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  analytics        Analytics[]
  chatMessageLikes ChatMessageLike[]
  chatMessages     ChatMessage[]
  comments         Comment[]
  hostedEvents     Event[]           @relation("HostedEvents")
  posts            Post[]
  reactions        Reaction[]
  registrations    Registration[]
  sessions         Session[]
  hostedWebinars   Webinar[]         @relation("HostedWebinars")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Webinar {
  id                                 String                    @id @default(cuid())
  slug                               String?                   @unique
  internalName                       String?
  title                              String
  description                        String
  thumbnail                          String?
  duration                           Int
  vimeoVideoId                       String?
  videoUrl                           String?
  videoDuration                      Int?
  status                             WebinarStatus             @default(DRAFT)
  recordingUrl                       String?
  hostId                             String
  hasReplay                          Boolean                   @default(true)
  hasOffers                          Boolean                   @default(true)
  hasChat                            Boolean                   @default(true)
  hasReactions                       Boolean                   @default(true)
  showElapsedTime                    Boolean                   @default(true)
  maxSchedulesToShow                 Int                       @default(3)
  registrationPageId                 String?
  thankYouTemplateId                 String?
  countdownTemplateId                String?
  countdownPageId                    String?
  enableABTesting                    Boolean                   @default(false)
  trafficSplitPercent                Int                       @default(50)
  testRegistrationPage               Boolean                   @default(false)
  regPageAId                         String?
  regPageBId                         String?
  testSchedule                       Boolean                   @default(false)
  scheduleAIds                       String?
  scheduleBIds                       String?
  testOffer                          Boolean                   @default(false)
  offerAId                           String?
  offerBId                           String?
  testVideo                          Boolean                   @default(false)
  videoAId                           String?
  videoBId                           String?
  whatsappShareMessage               String?
  facebookShareMessage               String?
  createdAt                          DateTime                  @default(now())
  updatedAt                          DateTime                  @updatedAt
  replayDurationDays                 Int?
  replayEnabled                      Boolean                   @default(true)
  replayExpiresAt                    DateTime?
  mostlyAttendedThreshold            Int?
  autoSendPostSessionSMS             Boolean                   @default(false)
  postSessionSMSMinutesAfter         Int                       @default(0)
  postSessionSMSMinWatchedMinutes    Int?
  postSessionSMSMinWatchedPercentage Int?
  postSessionSMSBody                 String?
  roundJITTo15Minutes                Boolean                   @default(true)
  registrationTag                    String?
  attendedTag                        String?
  mostlyAttendedTag                  String?
  partlyAttendedTag                  String?
  missedTag                          String?
  replayAttendedTag                  String?
  attendedTagId                      Int?
  missedTagId                        Int?
  mostlyAttendedTagId                Int?
  partlyAttendedTagId                Int?
  registrationTagId                  Int?
  replayAttendedTagId                Int?
  offers                             Offer[]
  aiChatConfig                       AIChatConfig?
  analytics                          Analytics[]
  bonusResources                     BonusResource[]
  chatMessages                       ChatMessage[]
  bundledEvents                      Event[]                   @relation("BundledWebinars")
  leadPages                          LeadPage[]
  programDocuments                   ProgramDocument[]
  reactions                          Reaction[]
  registrations                      Registration[]
  faqs                               WebinarFaq[]
  reminderTemplates                  WebinarReminderTemplate[]
  sales                              WebinarSale[]
  schedules                          WebinarSchedule[]
  host                               User                      @relation("HostedWebinars", fields: [hostId], references: [id])

  @@map("webinars")
}

model WebinarSchedule {
  id               String    @id @default(cuid())
  webinarId        String
  scheduleType     String
  scheduledAt      DateTime?
  timezone         String?
  useUserTimezone  Boolean   @default(false)
  minutesFromReg   Int?
  recurringPattern String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isZoomSession    Boolean   @default(false)
  zoomLink         String?
  webinar          Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("webinar_schedules")
}

model Offer {
  id                String   @id @default(cuid())
  webinarId         String
  title             String
  description       String?
  price             Float
  originalPrice     Float?
  discountLabel     String?
  countdownDuration Int?
  bulletPoints      String[] @default([])
  ctaText           String   @default("Get This Offer")
  ctaUrl            String
  videoTimestamp    Int
  hideAfter         Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  webinar           Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)
}

model BonusResource {
  id          String   @id @default(cuid())
  webinarId   String
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int?
  downloads   Int      @default(0)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  webinar     Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("bonus_resources")
}

model ChatMessage {
  id             String            @id @default(cuid())
  webinarId      String
  userId         String?
  registrationId String?
  userName       String?
  message        String
  isScripted     Boolean           @default(false)
  videoTimestamp Int?
  isHidden       Boolean           @default(false)
  isApproved     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  isAI           Boolean           @default(false)
  likes          ChatMessageLike[]
  registration   Registration?     @relation(fields: [registrationId], references: [id])
  user           User?             @relation(fields: [userId], references: [id])
  webinar        Webinar           @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model ChatMessageLike {
  id             String        @id @default(cuid())
  chatMessageId  String
  userId         String?
  registrationId String?
  isSystem       Boolean       @default(false)
  likerName      String?
  createdAt      DateTime      @default(now())
  chatMessage    ChatMessage   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  registration   Registration? @relation(fields: [registrationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@unique([chatMessageId, userId, registrationId, likerName])
  @@map("chat_message_likes")
}

model Reaction {
  id             String        @id @default(cuid())
  webinarId      String
  userId         String?
  registrationId String?
  userName       String?
  type           String
  isScripted     Boolean       @default(false)
  videoTimestamp Int
  isHidden       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  registration   Registration? @relation(fields: [registrationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
  webinar        Webinar       @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, videoTimestamp])
  @@map("reactions")
}

model Registration {
  id                       String                    @id @default(cuid())
  userId                   String?
  webinarId                String
  scheduleId               String?
  name                     String
  email                    String
  phone                    String?
  timezone                 String?
  country                  String?
  gdprConsent              Boolean                   @default(false)
  privacyConsent           Boolean                   @default(false)
  marketingConsent         Boolean                   @default(false)
  registeredAt             DateTime                  @default(now())
  scheduledStartTime       DateTime?
  attended                 Boolean                   @default(false)
  joinedAt                 DateTime?
  firstJoinedAt            DateTime?
  leftAt                   DateTime?
  testGroup                String?
  referralCode             String?                   @unique
  referredBy               String?
  registrationDevice       String?
  replayClickedCTA         Boolean                   @default(false)
  replayDevice             String?
  replayWatchTime          Int                       @default(0)
  watchedReplay            Boolean                   @default(false)
  lastWatchedPosition      Int                       @default(0)
  hasPurchased             Boolean                   @default(false)
  attendanceTagsApplied    Boolean                   @default(false)
  attendanceTagsAppliedAt  DateTime?
  postSessionSmsSent       Boolean                   @default(false)
  postSessionSmsSentAt     DateTime?
  testMetrics              ABTestMetric[]
  sessions                 AttendeeSession[]
  chatMessageLikes         ChatMessageLike[]
  chatMessages             ChatMessage[]
  clickFunnelsReminderTags ClickFunnelsReminderTag[]
  offerAnalytics           OfferAnalytics[]
  pageVisits               PageVisit[]
  reactions                Reaction[]
  referredByUser           Registration?             @relation("Referrals", fields: [referredBy], references: [referralCode])
  referrals                Registration[]            @relation("Referrals")
  user                     User?                     @relation(fields: [userId], references: [id])
  webinar                  Webinar                   @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  reminders                WebinarReminderSent[]
  sales                    WebinarSale[]
  splitTestId              String?
  splitTestVariantId       String?
  splitTest                SplitTest?                @relation(fields: [splitTestId], references: [id])
  splitTestVariant         SplitTestVariant?         @relation(fields: [splitTestVariantId], references: [id])

  @@index([email])
  @@index([webinarId])
  @@index([webinarId, attended])
  @@index([webinarId, registeredAt])
  @@index([userId])
  @@map("registrations")
}

model ABTestMetric {
  id             String        @id @default(cuid())
  webinarId      String
  visitorId      String
  testGroup      String
  element        String
  variantShown   String
  pageView       DateTime      @default(now())
  converted      Boolean       @default(false)
  registrationId String?
  timeOnPage     Int?
  clicks         Int           @default(0)
  country        String?
  referrer       String?
  device         String?
  createdAt      DateTime      @default(now())
  registration   Registration? @relation(fields: [registrationId], references: [id])

  @@index([webinarId, element, testGroup])
  @@index([visitorId])
  @@map("ab_test_metrics")
}

model AttendeeSession {
  id              String            @id @default(cuid())
  registrationId  String
  webinarId       String
  scheduleId      String?
  joinedAt        DateTime          @default(now())
  leftAt          DateTime?
  lastSeenAt      DateTime          @default(now())
  totalWatchTime  Int               @default(0)
  videoPosition   Int               @default(0)
  isWatching      Boolean           @default(true)
  isActive        Boolean           @default(true)
  completed       Boolean           @default(false)
  userAgent       String?
  device          String?
  browser         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastMuteState   Boolean?
  mutedDuration   Int               @default(0)
  unmutedDuration Int               @default(0)
  watchDuration   Int               @default(0)
  watchedMuted    Boolean           @default(true)
  registration    Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  engagements     EngagementEvent[]
  pageVisits      PageVisit[]
  videoEvents     VideoWatchEvent[]

  @@index([registrationId])
  @@index([webinarId, scheduleId])
  @@index([webinarId, completed])
  @@index([joinedAt])
  @@map("attendee_sessions")
}

model VideoWatchEvent {
  id          String          @id @default(cuid())
  sessionId   String
  webinarId   String
  timestamp   Int
  eventType   String
  watchedFrom Int?
  watchedTo   Int?
  createdAt   DateTime        @default(now())
  session     AttendeeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([webinarId, timestamp])
  @@map("video_watch_events")
}

model EngagementEvent {
  id        String          @id @default(cuid())
  sessionId String
  webinarId String
  eventType String
  eventData String?
  timestamp Int
  createdAt DateTime        @default(now())
  session   AttendeeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([webinarId, eventType])
  @@index([webinarId, timestamp])
  @@map("engagement_events")
}

model PageVisit {
  id             String           @id @default(cuid())
  sessionId      String?
  registrationId String?
  webinarId      String
  visitorId      String
  pageType       String
  pageId         String?
  variantGroup   String?
  enteredAt      DateTime         @default(now())
  leftAt         DateTime?
  timeSpent      Int?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  device         String?
  browser        String?
  country        String?
  createdAt      DateTime         @default(now())
  registration   Registration?    @relation(fields: [registrationId], references: [id])
  session        AttendeeSession? @relation(fields: [sessionId], references: [id])

  @@index([webinarId, pageType])
  @@index([webinarId, pageType, pageId])
  @@index([webinarId, enteredAt])
  @@index([visitorId])
  @@index([registrationId])
  @@map("page_visits")
}

model OfferAnalytics {
  id             String       @id @default(cuid())
  webinarId      String
  registrationId String
  offerTitle     String
  offerUrl       String
  sawOffer       Boolean      @default(false)
  sawOfferAt     DateTime?
  clickedOffer   Boolean      @default(false)
  clickedOfferAt DateTime?
  videoPosition  Int?
  converted      Boolean      @default(false)
  convertedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([webinarId])
  @@index([registrationId])
  @@index([webinarId, sawOffer])
  @@index([webinarId, clickedOffer])
  @@index([webinarId, converted])
  @@map("offer_analytics")
}

model WebinarSale {
  id             String        @id @default(cuid())
  webinarId      String
  registrationId String?
  email          String
  orderId        String        @unique
  orderFormId    String?
  orderFormName  String?
  productName    String?
  status         String?
  amount         Float?
  currency       String?       @default("USD")
  contactId      String?
  purchasedAt    DateTime?
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  registration   Registration? @relation(fields: [registrationId], references: [id])
  webinar        Webinar       @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
  @@index([registrationId])
  @@index([email])
  @@map("webinar_sales")
}

model Post {
  id        String    @id @default(cuid())
  content   String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Analytics {
  id        String   @id @default(cuid())
  userId    String?
  webinarId String?
  event     String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  webinar   Webinar? @relation(fields: [webinarId], references: [id])

  @@map("analytics")
}

model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  htmlCode    String
  thumbnail   String?
  popupStyle  String   @default("center")
  popupTheme  String   @default("purple")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}

model ThankYouTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  htmlCode    String
  thumbnail   String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("thank_you_templates")
}

model CountdownTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  htmlCode    String
  thumbnail   String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countdown_templates")
}

model RegistrationPage {
  id                 String     @id @default(cuid())
  name               String     @unique
  description        String?
  htmlCode           String
  collectPhone       Boolean    @default(false)
  collectCompany     Boolean    @default(false)
  collectCustom1     Boolean    @default(false)
  customField1Label  String?
  collectCustom2     Boolean    @default(false)
  customField2Label  String?
  showHostInfo       Boolean    @default(true)
  showBenefits       Boolean    @default(true)
  showTestimonials   Boolean    @default(false)
  showCountdown      Boolean    @default(true)
  showSocialProof    Boolean    @default(true)
  showVideo          Boolean    @default(false)
  videoUrl           String?
  videoTitle         String?
  videoAutoplay      Boolean    @default(false)
  testimonial1Text   String?
  testimonial1Author String?
  testimonial1Image  String?
  testimonial2Text   String?
  testimonial2Author String?
  testimonial2Image  String?
  testimonial3Text   String?
  testimonial3Author String?
  testimonial3Image  String?
  benefit1           String?
  benefit2           String?
  benefit3           String?
  benefit4           String?
  benefit5           String?
  logoUrl            String?
  primaryColor       String?    @default("#4f46e5")
  secondaryColor     String?    @default("#8b5cf6")
  backgroundColor    String?    @default("#ffffff")
  textColor          String?    @default("#1f2937")
  ctaButtonText      String?    @default("Register Now")
  ctaButtonStyle     String?    @default("solid")
  showFooter         Boolean    @default(true)
  footerText         String?
  privacyPolicyUrl   String?
  termsOfServiceUrl  String?
  thumbnail          String?
  metaDescription    String?
  isSystem           Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  leadPages          LeadPage[]

  @@map("registration_pages")
}

model CountdownPage {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  htmlCode         String
  showVideo        Boolean  @default(false)
  videoUrl         String?
  videoTitle       String?
  videoPlaceholder String?  @default("Watch this important message")
  showBonus        Boolean  @default(false)
  bonusTitle       String?
  bonusDescription String?
  bonusImage       String?
  bonusValue       String?
  bonusBadge       String?
  showReminder     Boolean  @default(true)
  showWhatsApp     Boolean  @default(true)
  showFacebook     Boolean  @default(true)
  showCustomCTA    Boolean  @default(false)
  customCTAText    String?
  customCTAUrl     String?
  organizationName String?
  contactEmail     String?
  websiteUrl       String?
  logoUrl          String?
  thumbnail        String?
  primaryColor     String?  @default("#4a3b6b")
  accentColor      String?  @default("#d53f8c")
  isSystem         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@map("countdown_pages")
}

model WebinarFaq {
  id        String   @id @default(cuid())
  webinarId String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  webinar   Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("webinar_faqs")
}

model ProgramDocument {
  id        String   @id @default(cuid())
  webinarId String
  title     String
  content   String
  category  String   @default("general")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  webinar   Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("program_documents")
}

model AIChatConfig {
  id                 String   @id @default(cuid())
  webinarId          String   @unique
  enabled            Boolean  @default(true)
  activateAfterOffer Boolean  @default(true)
  systemPrompt       String?
  temperature        Float    @default(0.7)
  maxTokens          Int      @default(500)
  autoRespond        Boolean  @default(true)
  requireApproval    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  assistantName      String   @default("AI Assistant")
  autoLikeEnabled    Boolean  @default(true)
  autoLikePrompt     String?
  webinar            Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("ai_chat_config")
}

model Image {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  size         Int
  mimeType     String
  width        Int?
  height       Int?
  uploadedBy   String?
  tags         String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([uploadedBy])
  @@map("images")
}

model WebinarReminderTemplate {
  id                   String                @id @default(cuid())
  webinarId            String
  minutesBefore        Int?
  channel              ReminderChannel       @default(EMAIL)
  emailSubject         String?
  emailBody            String?
  smsBody              String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())
  clickFunnelsTag      String?
  applyClickFunnelsTag Boolean               @default(false)
  minWatchedMinutes    Int?
  minWatchedPercentage Int?
  minutesAfter         Int?
  type                 String                @default("pre_webinar")
  webinar              Webinar               @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  sentReminders        WebinarReminderSent[]

  @@index([webinarId])
  @@index([minutesBefore])
  @@map("webinar_reminder_templates")
}

model WebinarReminderSent {
  id             String                   @id @default(cuid())
  templateId     String?
  registrationId String
  scheduledFor   DateTime?
  sentAt         DateTime?
  status         ReminderStatus           @default(PENDING)
  channel        ReminderChannel          @default(SMS)
  errorMessage   String?
  retryCount     Int                      @default(0)
  lastRetryAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now())
  emailSentTo    String?
  smsSentTo      String?
  error          String?
  message        String?
  phone          String?
  sendAt         DateTime?
  type           String                   @default("pre_webinar")
  registration   Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template       WebinarReminderTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([templateId])
  @@index([scheduledFor])
  @@index([status])
  @@index([status, scheduledFor])
  @@map("webinar_reminders_sent")
}

model ClickFunnelsReminderTag {
  id             String         @id @default(cuid())
  registrationId String
  tagName        String
  scheduledFor   DateTime
  status         ReminderStatus @default(PENDING)
  appliedAt      DateTime?
  attempts       Int            @default(0)
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, tagName])
  @@index([registrationId])
  @@index([status, scheduledFor])
  @@map("clickfunnels_reminder_tags")
}

model Form {
  id                  String           @id @default(cuid())
  title               String
  slug                String           @unique
  description         String?
  submitText          String           @default("Submit")
  successMsg          String           @default("Thank you for your submission.")
  isActive            Boolean          @default(true)
  primaryColor        String           @default("#4f46e5")
  backgroundColor     String           @default("#ffffff")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now())
  aiApproveMsg        String?          @default("Congratulations! Your application has been approved.")
  aiApproveTitle      String?          @default("Application Approved")
  aiAssessmentEnabled Boolean          @default(false)
  aiPrompt            String?
  aiRejectMsg         String?          @default("Sorry, your application does not meet the criteria.")
  aiRejectTitle       String?          @default("Application Rejected")
  aiReviewMsg         String?          @default("Your application is under review.")
  aiReviewTitle       String?          @default("Sent for Approval")
  redirectUrl         String?
  fields              FormField[]
  submissions         FormSubmission[]
  views               FormView[]

  @@map("forms")
}

model FormField {
  id          String   @id @default(cuid())
  formId      String
  type        String
  label       String
  placeholder String?
  required    Boolean  @default(false)
  options     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  data        String
  userAgent   String?
  referrer    String?
  createdAt   DateTime @default(now())
  aiReason    String?
  aiStatus    String?
  lastSavedAt DateTime @default(now())
  status      String   @default("COMPLETED")
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_submissions")
}

model FormView {
  id        String   @id @default(cuid())
  formId    String
  visitorId String?
  ip        String?
  userAgent String?
  referrer  String?
  viewedAt  DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_views")
}

model LeadPage {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  type              String             @default("TEMPLATE")
  templateId        String?
  htmlContent       String?
  webinarId         String?
  views             Int                @default(0)
  conversions       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
  template          RegistrationPage?  @relation(fields: [templateId], references: [id])
  webinar           Webinar?           @relation(fields: [webinarId], references: [id])
  splitTestVariants SplitTestVariant[]

  @@map("lead_pages")
}

model SplitTest {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  isActive    Boolean            @default(true)
  views       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now())
  conversions Int                @default(0)
  events      SplitTestEvent[]
  variants    SplitTestVariant[]
  registrations Registration[]

  @@map("split_tests")
}

model SplitTestVariant {
  id          String           @id @default(cuid())
  splitTestId String
  leadPageId  String
  weight      Int              @default(50)
  views       Int              @default(0)
  conversions Int              @default(0)
  events      SplitTestEvent[]
  leadPage    LeadPage         @relation(fields: [leadPageId], references: [id], onDelete: Cascade)
  splitTest   SplitTest        @relation(fields: [splitTestId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@map("split_test_variants")
}

model SplitTestEvent {
  id          String           @id @default(cuid())
  splitTestId String
  variantId   String
  type        String
  visitorId   String?
  createdAt   DateTime         @default(now())
  splitTest   SplitTest        @relation(fields: [splitTestId], references: [id], onDelete: Cascade)
  variant     SplitTestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([splitTestId, createdAt])
  @@index([variantId, createdAt])
  @@map("split_test_events")
}

model Event {
  id                       String              @id @default(cuid())
  slug                     String              @unique
  title                    String
  description              String?
  thumbnail                String?
  hostId                   String
  status                   EventStatus         @default(DRAFT)
  zoomLink                 String?
  zoomMeetingId            String?
  zoomPassword             String?
  bundledWebinarId         String?
  bundleDescription        String?
  webinarOptional          Boolean             @default(true)
  maxAttendees             Int?
  requirePhone             Boolean             @default(false)
  confirmationEmailEnabled Boolean             @default(true)
  reminderEmailEnabled     Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  registrations            EventRegistration[]
  schedules                EventSchedule[]
  bundledWebinar           Webinar?            @relation("BundledWebinars", fields: [bundledWebinarId], references: [id])
  host                     User                @relation("HostedEvents", fields: [hostId], references: [id])

  @@map("events")
}

model EventSchedule {
  id            String              @id @default(cuid())
  eventId       String
  startTime     DateTime
  endTime       DateTime?
  timezone      String              @default("America/New_York")
  zoomLink      String?
  zoomMeetingId String?
  zoomPassword  String?
  maxAttendees  Int?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startTime])
  @@map("event_schedules")
}

model EventRegistration {
  id                    String        @id @default(cuid())
  eventId               String
  eventScheduleId       String
  name                  String
  email                 String
  phone                 String?
  timezone              String?
  registeredAt          DateTime      @default(now())
  attended              Boolean       @default(false)
  joinedAt              DateTime?
  webinarRegistrationId String?
  skippedWebinar        Boolean       @default(false)
  gdprConsent           Boolean       @default(false)
  privacyConsent        Boolean       @default(false)
  marketingConsent      Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  event                 Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSchedule         EventSchedule @relation(fields: [eventScheduleId], references: [id], onDelete: Cascade)

  @@unique([email, eventScheduleId])
  @@index([eventId])
  @@index([email])
  @@map("event_registrations")
}

model SMSSettings {
  id               String   @id @default("default")
  blockedTimezones String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("sms_settings")
}

enum Role {
  ADMIN
  HOST
  ATTENDEE
}

enum WebinarStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum ReminderChannel {
  EMAIL
  SMS
  BOTH
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}
