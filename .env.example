# Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/webinar_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Anthropic (Claude) — optional; enables the "Claude" provider in the lead-page AI editor
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Optional: Email service (for notifications)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-password"

# Optional: ClickSend SMS reminders (required for SMS channels)
CLICK_SEND_USERNAME="emaaanWork"

CLICK_SEND_API_KEY="81ACB559-9540-9010-EC2F-0EAE11BDEFE6"
CLICK_SEND_FROM="+18332993106" # Optional sender ID (alphabetic or shortcode)

# Email Provider: "microsoft" (default) | "ses" | "ses_fallback"
# EMAIL_PROVIDER="microsoft"

# Optional: AWS SES (email sending)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_SES_REGION="us-east-1"
# AWS_SES_FROM_EMAIL="noreply@yourdomain.com"  # Must be verified in SES

# Optional: AWS S3 (for recording storage)
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# Optional: ClickFunnels 2.0 integration
CLICKFUNNELS_API_KEY="your-clickfunnels-api-key"
CLICKFUNNELS_WORKSPACE_ID="your-workspace-id"
CLICKFUNNELS_WEBINAR_TAG="UM-Webinar-Registered"
CLICKFUNNELS_WEBINAR_TAG_ID="your-tag-id"
CLICKFUNNELS_TAG_ATTENDED="your-tag-id"
CLICKFUNNELS_TAG_MOSTLY_ATTENDED="your-tag-id"
CLICKFUNNELS_TAG_PARTLY_ATTENDED="your-tag-id"
CLICKFUNNELS_TAG_MISSED="your-tag-id"
CLICKFUNNELS_TAG_REPLAY_ATTENDED="your-tag-id"

# Optional: Mautic contact + tag sync
MAUTIC_BASE_URL="https://mautic.example.com"
# Use either an OAuth access token...
# MAUTIC_ACCESS_TOKEN="your-mautic-access-token"
# ...or basic auth credentials if basic auth is enabled in Mautic
# MAUTIC_USERNAME="your-mautic-username"
# MAUTIC_PASSWORD="your-mautic-password"
# Optional custom field aliases if your Mautic instance uses non-default fields
# MAUTIC_PHONE_FIELD_ALIAS="phone"
# MAUTIC_COUNTRY_FIELD_ALIAS="country"
# MAUTIC_TIMEZONE_FIELD_ALIAS="timezone"

# Optional: WebinarJam Integration (for syncing to Facebook CAPI)
# Get your API key from: https://app.webinarjam.com/settings/api
WEBINARJAM_API_KEY="your-webinarjam-api-key"
# Comma-separated list of WebinarJam webinar IDs to track
WEBINARJAM_WEBINAR_IDS="123456,789012"

# Stripe (required for checkout/funnel system)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
